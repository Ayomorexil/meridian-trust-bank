meta {
  name: Get Transfer Receipt
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/transfers/{{transferId}}/receipt
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{memberToken}}
}

docs {
  Run "Create Transfer (Internal)" first — that captures {{transferId}}
  and it'll already be "completed" so a receipt is available immediately.
}
